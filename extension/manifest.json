{
  "manifest_version": 3,
  "name": "NewsLoop Recorder",
  "version": "1.0.0",
  "description": "在十秒內把新聞事件與交易論點記錄到 Notion。",
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_title": "NewsLoop"
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://127.0.0.1:8000/*"
  ]
}
