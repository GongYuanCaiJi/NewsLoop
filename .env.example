# 必填：Notion integration 與 database
NOTION_TOKEN=
NEWS_ALPHA_DB_ID=
NOTION_VERSION=2022-06-28

# 選填：市場資料 provider
TWELVE_DATA_API_KEY=
FUGLE_API_KEY=

# 選填：AI provider
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# 選填：backend 網路設定。預設只綁定 127.0.0.1:8000。
NEWS_ALPHA_API_HOST=127.0.0.1
NEWS_ALPHA_API_PORT=8000
NEWS_ALPHA_BIND_ALL=0
# 非 loopback 綁定時必填；請產生高熵隨機值。
NEWS_ALPHA_API_KEY=
NEWS_ALPHA_EXTENSION_IDS=

# 選填：防護與 cache；以下是程式預設值。
NEWS_ALPHA_RATE_LIMIT_WINDOW=60
NEWS_ALPHA_RATE_LIMIT_MAX=120
NEWS_ALPHA_ALLOWED_ORIGINS_TTL=30
NEWS_ALPHA_MAX_BODY_BYTES=1048576
NOTION_SCHEMA_TTL_SECONDS=900
NOTION_DB_PROPS_CACHE_TTL_SECONDS=60
SECTOR_CACHE_TTL_SECONDS=86400
SECTOR_ERROR_TTL_SECONDS=60
SECTOR_RATE_LIMIT_TTL_SECONDS=300
SECTOR_FETCH_TIMEOUT_SECONDS=3
